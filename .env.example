# ===== CONFIGURAÇÕES DA API (Backend) =====

# Segurança JWT
SECRET_KEY=troque-por-uma-chave-super-secreta-aqui-min-32-caracteres

# Banco de dados
# Desenvolvimento (SQLite - padrão):
DATABASE_URL=sqlite:///data/users.db

# Produção (PostgreSQL - Render/Heroku):
# DATABASE_URL=postgresql://user:password@host:5432/database

# Ambiente
ENVIRONMENT=development


# ===== CONFIGURAÇÕES DO FRONTEND (Streamlit) =====

# URL da API
# Desenvolvimento:
API_URL=http://localhost:8000

# Produção (Render):
# API_URL=https://lotoscience-api.onrender.com
